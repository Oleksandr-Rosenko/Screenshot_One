<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <AssemblyName>Screenshot_One</AssemblyName>
    <Product>Screenshot One</Product>
    <AssemblyTitle>Screenshot One</AssemblyTitle>
    <Version>2.10.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0-windows'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ціль з Windows SDK потрібна для системного OCR (Windows.Media.Ocr); запуск — з Windows 10 1809 -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="credentials.json" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-windows'))">
    <None Update="ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- credentials.json не зберігається в git (публічний репозиторій): кладіть його в папку проєкту локально.
         Без нього збірка проходить, просто завантаження на Google Drive повідомить, що ключа немає. -->
    <EmbeddedResource Include="credentials.json" Condition="Exists('credentials.json')" />
  </ItemGroup>

  <!-- Common Packages -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.75.0.4192" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.0" />
    <PackageReference Include="Xabe.FFmpeg" Version="6.0.2" />
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
  </ItemGroup>

  <!-- Windows-specific Packages -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-windows'))">
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <!-- macOS / Cross-platform Packages -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
  </ItemGroup>
</Project>
