<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        x:Class="ScreenShot_One_Avalonia.SettingsWindow"
        Title="{DynamicResource Settings_Title}" Width="600" Height="760" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico">

	<suki:SukiWindow.Styles>
		<!-- Розділ: картка з рядками «назва ліворуч — керування праворуч» -->
		<Style Selector="Border.section">
			<Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="16,6"/>
		</Style>
		<Style Selector="TextBlock.sectionTitle">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
			<Setter Property="Margin" Value="4,0,0,6"/>
		</Style>
		<Style Selector="Grid.row">
			<Setter Property="MinHeight" Value="48"/>
		</Style>
		<Style Selector="TextBlock.label">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="Border.divider">
			<Setter Property="Height" Value="1"/>
			<Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
		</Style>
		<Style Selector="TextBox.hotkey">
			<Setter Property="Width" Value="220"/>
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Margin" Value="0,6"/>
		</Style>
	</suki:SukiWindow.Styles>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
	<StackPanel Margin="18,14,18,18" Spacing="18">

		<!-- Загальні -->
		<StackPanel>
			<TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_General}"/>
			<Border Classes="section">
				<StackPanel>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_StartOnBoot}"/>
						<ToggleSwitch Grid.Column="1" Name="ChkStartOnBoot" OnContent="" OffContent="" VerticalAlignment="Center"/>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_CopyOnCapture}"/>
						<ToggleSwitch Grid.Column="1" Name="ChkCopyToClipboard" OnContent="" OffContent="" VerticalAlignment="Center"/>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_CopyLink}"/>
						<ToggleSwitch Grid.Column="1" Name="ChkCopyLink" OnContent="" OffContent="" VerticalAlignment="Center"/>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_Theme}"/>
						<ComboBox Grid.Column="1" Name="ComboTheme" Width="240" VerticalAlignment="Center" SelectionChanged="ComboTheme_SelectionChanged">
							<ComboBoxItem Content="{DynamicResource Settings_ThemeDark}"/>
							<ComboBoxItem Content="{DynamicResource Settings_ThemeLight}"/>
						</ComboBox>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_Language}"/>
						<!-- Назви мов — завжди своєю мовою, щоб свою мову можна було знайти з будь-якої -->
						<ComboBox Grid.Column="1" Name="ComboLanguage" Width="240" VerticalAlignment="Center" SelectionChanged="ComboLanguage_SelectionChanged">
							<ComboBoxItem Content="{DynamicResource Settings_LanguageAuto}"/>
							<ComboBoxItem Content="Українська"/>
							<ComboBoxItem Content="English"/>
							<ComboBoxItem Content="Русский"/>
						</ComboBox>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

		<!-- Дозволи macOS (лише на Mac): стан і кнопка до потрібної сторінки «Конфіденційність і безпека» -->
		<StackPanel Name="MacPermissionsSection" IsVisible="False">
			<TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_Permissions}"/>
			<Border Classes="section">
				<StackPanel>
					<Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
						<StackPanel VerticalAlignment="Center" Margin="0,6">
							<TextBlock Classes="label" Text="{DynamicResource Perm_Screen}"/>
							<TextBlock Classes="hint" Text="{DynamicResource Perm_ScreenHint}"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0">
							<Ellipse Name="DotScreen" Width="8" Height="8" VerticalAlignment="Center"/>
							<TextBlock Name="TxtPermScreen" FontSize="12" VerticalAlignment="Center"/>
						</StackPanel>
						<Button Grid.Column="2" Name="BtnPermScreen" MinWidth="120" VerticalAlignment="Center" Click="BtnPerm_Click" Tag="Screen"/>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
						<StackPanel VerticalAlignment="Center" Margin="0,6">
							<TextBlock Classes="label" Text="{DynamicResource Perm_Mic}"/>
							<TextBlock Classes="hint" Text="{DynamicResource Perm_MicHint}"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0">
							<Ellipse Name="DotMic" Width="8" Height="8" VerticalAlignment="Center"/>
							<TextBlock Name="TxtPermMic" FontSize="12" VerticalAlignment="Center"/>
						</StackPanel>
						<Button Grid.Column="2" Name="BtnPermMic" MinWidth="120" VerticalAlignment="Center" Click="BtnPerm_Click" Tag="Mic"/>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
						<StackPanel VerticalAlignment="Center" Margin="0,6">
							<TextBlock Classes="label" Text="{DynamicResource Perm_Keys}"/>
							<TextBlock Classes="hint" Text="{DynamicResource Perm_KeysHint}"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0">
							<Ellipse Name="DotKeys" Width="8" Height="8" VerticalAlignment="Center"/>
							<TextBlock Name="TxtPermKeys" FontSize="12" VerticalAlignment="Center"/>
						</StackPanel>
						<Button Grid.Column="2" Name="BtnPermKeys" MinWidth="120" VerticalAlignment="Center" Click="BtnPerm_Click" Tag="Keys"/>
					</Grid>
					<Border Name="PermRestartRow" Classes="divider" IsVisible="False"/>
					<Grid Name="PermRestartPanel" Classes="row" ColumnDefinitions="*,Auto" IsVisible="False">
						<TextBlock Classes="hint" Text="{DynamicResource Perm_RestartHint}" VerticalAlignment="Center" Margin="0,8,12,8"/>
						<Button Grid.Column="1" Content="{DynamicResource Perm_Restart}" MinWidth="120" VerticalAlignment="Center" Click="BtnPermRestart_Click"/>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

		<!-- Знімки та файли -->
		<StackPanel>
			<TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_Capture}"/>
			<Border Classes="section">
				<StackPanel>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_AfterCapture}"/>
						<ComboBox Grid.Column="1" Name="ComboAfterCapture" Width="240" VerticalAlignment="Center">
							<ComboBoxItem Content="{DynamicResource Settings_OpenEditor}"/>
							<ComboBoxItem Content="{DynamicResource Settings_ShowThumbnail}"/>
						</ComboBox>
					</Grid>
					<Border Classes="divider"/>
					<StackPanel Margin="0,10" Spacing="8">
						<TextBlock Classes="label" Text="{DynamicResource Settings_SaveFolder}"/>
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<TextBox Name="TxtSaveFolder" IsReadOnly="True" FontSize="13"/>
							<Button Name="BtnChooseFolder" Grid.Column="1" Content="{DynamicResource Settings_Choose}" Click="BtnChooseFolder_Click"/>
						</Grid>
					</StackPanel>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_Format}"/>
						<ComboBox Grid.Column="1" Name="ComboSaveFormat" Width="240" VerticalAlignment="Center">
							<ComboBoxItem Content="{DynamicResource Settings_FormatPng}"/>
							<ComboBoxItem Content="{DynamicResource Settings_FormatJpg}"/>
						</ComboBox>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,8">
							<TextBlock Classes="label" Text="{DynamicResource Settings_AutoSave}"/>
							<TextBlock Classes="hint" Text="{DynamicResource Settings_AutoSaveHint}"/>
						</StackPanel>
						<ToggleSwitch Grid.Column="1" Name="ChkAutoSave" OnContent="" OffContent="" VerticalAlignment="Center"/>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

		<!-- Гарячі клавіші -->
		<StackPanel>
			<TextBlock Classes="sectionTitle" Text="{DynamicResource Settings_Hotkeys}"/>
			<Border Classes="section">
				<StackPanel>
					<TextBlock Classes="hint" Text="{DynamicResource Settings_HotkeysHint}" Margin="0,10,0,4"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_HkRegion}"/>
						<TextBox Grid.Column="1" Name="TxtRegionKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="Region"/>
					</Grid>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_HkFullScreen}"/>
						<TextBox Grid.Column="1" Name="TxtFullScreenKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="FullScreen"/>
					</Grid>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Settings_HkAllScreens}"/>
						<TextBox Grid.Column="1" Name="TxtAllScreensKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="AllScreens"/>
					</Grid>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Common_RecordVideo}"/>
						<TextBox Grid.Column="1" Name="TxtVideoKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="Video"/>
					</Grid>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="{DynamicResource Common_Ocr}"/>
						<TextBox Grid.Column="1" Name="TxtOcrKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="Ocr"/>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

		<Button Classes="Flat" Content="{DynamicResource Settings_SaveAndClose}" FontWeight="SemiBold" FontSize="15"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" CornerRadius="10" Click="BtnSave_Click"/>
		<TextBlock Name="TxtCurrentVersion" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
	</StackPanel>
	</ScrollViewer>
</suki:SukiWindow>
