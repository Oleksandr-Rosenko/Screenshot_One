<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        x:Class="ScreenShot_One_Avalonia.SettingsWindow"
        Title="Налаштування" Width="600" Height="760" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico">

	<suki:SukiWindow.Styles>
		<!-- Розділ: картка з рядками «назва ліворуч — керування праворуч» -->
		<Style Selector="Border.section">
			<Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="16,6"/>
		</Style>
		<Style Selector="TextBlock.sectionTitle">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
			<Setter Property="Margin" Value="4,0,0,6"/>
		</Style>
		<Style Selector="Grid.row">
			<Setter Property="MinHeight" Value="48"/>
		</Style>
		<Style Selector="TextBlock.label">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="Border.divider">
			<Setter Property="Height" Value="1"/>
			<Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
		</Style>
		<Style Selector="TextBox.hotkey">
			<Setter Property="Width" Value="220"/>
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Margin" Value="0,6"/>
		</Style>
	</suki:SukiWindow.Styles>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
	<StackPanel Margin="18,14,18,18" Spacing="18">

		<!-- Загальні -->
		<StackPanel>
			<TextBlock Classes="sectionTitle" Text="ЗАГАЛЬНІ"/>
			<Border Classes="section">
				<StackPanel>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Запускати програму разом із системою"/>
						<ToggleSwitch Grid.Column="1" Name="ChkStartOnBoot" OnContent="" OffContent="" VerticalAlignment="Center"/>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Копіювати скріншот у буфер одразу після знімка"/>
						<ToggleSwitch Grid.Column="1" Name="ChkCopyToClipboard" OnContent="" OffContent="" VerticalAlignment="Center"/>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Копіювати посилання після завантаження в хмару"/>
						<ToggleSwitch Grid.Column="1" Name="ChkCopyLink" OnContent="" OffContent="" VerticalAlignment="Center"/>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Тема оформлення"/>
						<ComboBox Grid.Column="1" Name="ComboTheme" Width="240" VerticalAlignment="Center" SelectionChanged="ComboTheme_SelectionChanged">
							<ComboBoxItem Content="Темна"/>
							<ComboBoxItem Content="Світла"/>
						</ComboBox>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

		<!-- Знімки та файли -->
		<StackPanel>
			<TextBlock Classes="sectionTitle" Text="ЗНІМКИ ТА ФАЙЛИ"/>
			<Border Classes="section">
				<StackPanel>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Після знімка"/>
						<ComboBox Grid.Column="1" Name="ComboAfterCapture" Width="240" VerticalAlignment="Center">
							<ComboBoxItem Content="Відкривати редактор"/>
							<ComboBoxItem Content="Показувати мініатюру"/>
						</ComboBox>
					</Grid>
					<Border Classes="divider"/>
					<StackPanel Margin="0,10" Spacing="8">
						<TextBlock Classes="label" Text="Папка для збереження"/>
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<TextBox Name="TxtSaveFolder" IsReadOnly="True" FontSize="13"/>
							<Button Name="BtnChooseFolder" Grid.Column="1" Content="Обрати…" Click="BtnChooseFolder_Click"/>
						</Grid>
					</StackPanel>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Формат файлу"/>
						<ComboBox Grid.Column="1" Name="ComboSaveFormat" Width="240" VerticalAlignment="Center">
							<ComboBoxItem Content="PNG — без втрат"/>
							<ComboBoxItem Content="JPG — менший розмір"/>
						</ComboBox>
					</Grid>
					<Border Classes="divider"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,8">
							<TextBlock Classes="label" Text="Автоматично зберігати кожен скріншот"/>
							<TextBlock Classes="hint" Text="У папку вище, при «Копіювати та закрити» і з мініатюри"/>
						</StackPanel>
						<ToggleSwitch Grid.Column="1" Name="ChkAutoSave" OnContent="" OffContent="" VerticalAlignment="Center"/>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

		<!-- Гарячі клавіші -->
		<StackPanel>
			<TextBlock Classes="sectionTitle" Text="ГАРЯЧІ КЛАВІШІ"/>
			<Border Classes="section">
				<StackPanel>
					<TextBlock Classes="hint" Text="Клікніть у поле й натисніть потрібну комбінацію клавіш." Margin="0,10,0,4"/>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Скріншот зони"/>
						<TextBox Grid.Column="1" Name="TxtRegionKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="Region"/>
					</Grid>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Скріншот екрана"/>
						<TextBox Grid.Column="1" Name="TxtFullScreenKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="FullScreen"/>
					</Grid>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Скріншот усіх екранів"/>
						<TextBox Grid.Column="1" Name="TxtAllScreensKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="AllScreens"/>
					</Grid>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Запис відео"/>
						<TextBox Grid.Column="1" Name="TxtVideoKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="Video"/>
					</Grid>
					<Grid Classes="row" ColumnDefinitions="*,Auto">
						<TextBlock Classes="label" Text="Розпізнати текст (OCR)"/>
						<TextBox Grid.Column="1" Name="TxtOcrKey" Classes="hotkey" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="Ocr"/>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

		<Button Classes="Flat" Content="Зберегти та закрити" FontWeight="SemiBold" FontSize="15"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" CornerRadius="10" Click="BtnSave_Click"/>
		<TextBlock Name="TxtCurrentVersion" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
	</StackPanel>
	</ScrollViewer>
</suki:SukiWindow>
