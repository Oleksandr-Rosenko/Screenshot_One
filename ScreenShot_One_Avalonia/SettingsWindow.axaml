<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        x:Class="ScreenShot_One_Avalonia.SettingsWindow"
        Title="Налаштування" SizeToContent="Height" Width="560" MaxHeight="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
	<StackPanel Margin="20" Spacing="15">
		<TextBlock Text="Загальні налаштування" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

		<ToggleSwitch Name="ChkStartOnBoot" Content="Запускати програму разом із системою" FontSize="16"/>
		<ToggleSwitch Name="ChkCopyToClipboard" Content="Копіювати скріншот в буфер відразу після створення" FontSize="16"/>
		<ToggleSwitch Name="ChkCopyLink" Content="Копіювати публічне посилання після завантаження в хмару" FontSize="16"/>

		<Grid ColumnDefinitions="*, Auto" Margin="0,5">
			<TextBlock Text="Тема оформлення:" FontSize="16" VerticalAlignment="Center"/>
			<ComboBox Name="ComboTheme" Grid.Column="1" Width="220" SelectionChanged="ComboTheme_SelectionChanged">
				<ComboBoxItem Content="Темна"/>
				<ComboBoxItem Content="Світла"/>
			</ComboBox>
		</Grid>

		<Border Height="1" Background="{DynamicResource SukiBorderBrush}" Margin="0,10"/>

		<TextBlock Text="Знімки та файли" FontSize="18" FontWeight="Bold"/>

		<Grid ColumnDefinitions="*, Auto" Margin="0,5">
			<TextBlock Text="Після знімка:" FontSize="16" VerticalAlignment="Center"/>
			<ComboBox Name="ComboAfterCapture" Grid.Column="1" Width="260">
				<ComboBoxItem Content="Відкривати редактор"/>
				<ComboBoxItem Content="Показувати мініатюру"/>
			</ComboBox>
		</Grid>

		<StackPanel Spacing="6">
			<TextBlock Text="Папка для збереження:" FontSize="16"/>
			<Grid ColumnDefinitions="*, Auto">
				<TextBox Name="TxtSaveFolder" IsReadOnly="True" FontSize="13"/>
				<Button Name="BtnChooseFolder" Grid.Column="1" Content="Обрати…" Margin="8,0,0,0" Click="BtnChooseFolder_Click"/>
			</Grid>
		</StackPanel>

		<Grid ColumnDefinitions="*, Auto" Margin="0,5">
			<TextBlock Text="Формат файлу:" FontSize="16" VerticalAlignment="Center"/>
			<ComboBox Name="ComboSaveFormat" Grid.Column="1" Width="260">
				<ComboBoxItem Content="PNG (без втрат)"/>
				<ComboBoxItem Content="JPG (менший розмір)"/>
			</ComboBox>
		</Grid>

		<ToggleSwitch Name="ChkAutoSave" Content="Автоматично зберігати кожен скріншот у цю папку" FontSize="16"/>

		<Border Height="1" Background="{DynamicResource SukiBorderBrush}" Margin="0,10"/>

		<TextBlock Text="Гарячі клавіші (Клікніть у поле та натисніть кнопку)" FontSize="18" FontWeight="Bold"/>

		<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*, Auto" Margin="0,10">
			<TextBlock Grid.Row="0" Text="Скріншот зони:" FontSize="16" VerticalAlignment="Center"/>
			<TextBox Grid.Row="0" Grid.Column="1" Name="TxtRegionKey" Width="220" IsReadOnly="True" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="Region" Margin="0,5"/>

			<TextBlock Grid.Row="1" Text="Скріншот екрана:" FontSize="16" VerticalAlignment="Center"/>
			<TextBox Grid.Row="1" Grid.Column="1" Name="TxtFullScreenKey" Width="220" IsReadOnly="True" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="FullScreen" Margin="0,5"/>

			<TextBlock Grid.Row="2" Text="Запис відео:" FontSize="16" VerticalAlignment="Center"/>
			<TextBox Grid.Row="2" Grid.Column="1" Name="TxtVideoKey" Width="220" IsReadOnly="True" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="Video" Margin="0,5"/>

			<TextBlock Grid.Row="3" Text="Скріншот усіх екранів:" FontSize="16" VerticalAlignment="Center"/>
			<TextBox Grid.Row="3" Grid.Column="1" Name="TxtAllScreensKey" Width="220" IsReadOnly="True" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="AllScreens" Margin="0,5"/>

			<TextBlock Grid.Row="4" Text="Розпізнати текст (OCR):" FontSize="16" VerticalAlignment="Center"/>
			<TextBox Grid.Row="4" Grid.Column="1" Name="TxtOcrKey" Width="220" IsReadOnly="True" KeyDown="Hotkey_KeyDown" KeyUp="Hotkey_KeyUp" Tag="Ocr" Margin="0,5"/>
		</Grid>

		<Border Height="1" Background="{DynamicResource SukiBorderBrush}" Margin="0,10"/>

		<Button Classes="Primary" Content="Зберегти та закрити" FontWeight="Bold" FontSize="16"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" Click="BtnSave_Click"/>
		<TextBlock Name="TxtCurrentVersion"
           HorizontalAlignment="Center"
           Margin="0,15,0,0"
           Opacity="0.5"
           FontSize="13"/>
	</StackPanel>
	</ScrollViewer>
</suki:SukiWindow>
