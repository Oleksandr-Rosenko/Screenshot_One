<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:local="using:ScreenShot_One_Avalonia"
        x:Class="ScreenShot_One_Avalonia.HistoryWindow"
        Title="Історія" Height="640" Width="820"
        WindowStartupLocation="CenterScreen">

	<Grid RowDefinitions="Auto,*">
		<Grid.Styles>
			<!-- Простий шаблон елемента: без підкладки й відступів SukiUI (картка сама малює рамку й наведення) -->
			<Style Selector="ListBox.gallery ListBoxItem">
				<Setter Property="Padding" Value="0"/>
				<Setter Property="Margin" Value="0"/>
				<Setter Property="Template">
					<ControlTemplate>
						<ContentPresenter Name="PART_ContentPresenter" Background="Transparent"
						                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
					</ControlTemplate>
				</Setter>
			</Style>
			<Style Selector="Border.hcard Border.hactions">
				<Setter Property="Opacity" Value="0"/>
			</Style>
			<Style Selector="Border.hcard:pointerover Border.hactions">
				<Setter Property="Opacity" Value="1"/>
			</Style>
			<Style Selector="Border.hcard:pointerover">
				<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
			</Style>
			<Style Selector="Button.hbtn">
				<Setter Property="Padding" Value="6"/>
				<Setter Property="CornerRadius" Value="7"/>
			</Style>
			<Style Selector="Button.hbtn material|MaterialIcon">
				<Setter Property="Width" Value="18"/>
				<Setter Property="Height" Value="18"/>
				<Setter Property="Foreground" Value="{DynamicResource ToolbarIconBrush}"/>
			</Style>
			<Style Selector="Button.danger:pointerover material|MaterialIcon">
				<Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
			</Style>
		</Grid.Styles>

		<!-- Шапка: вкладки ліворуч, очищення праворуч -->
		<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,14,18,6">
			<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<RadioButton Name="TabScreenshots" Classes="Chips" IsChecked="True" IsCheckedChanged="Tab_Checked">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<material:MaterialIcon Kind="ImageOutline" />
						<TextBlock Text="Скріншоти"/>
					</StackPanel>
				</RadioButton>
				<RadioButton Name="TabVideos" Classes="Chips" IsCheckedChanged="Tab_Checked">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<material:MaterialIcon Kind="VideoOutline" />
						<TextBlock Text="Відео"/>
					</StackPanel>
				</RadioButton>
			</StackPanel>
			<Button Grid.Column="1" Classes="Basic danger" Click="BtnClearAll_Click" ToolTip.Tip="Видалити всі записи цієї вкладки">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<material:MaterialIcon Kind="DeleteSweepOutline" Width="18" Height="18" Foreground="{DynamicResource MutedTextBrush}"/>
					<TextBlock Name="TxtClearAll" Text="Очистити скріншоти" Foreground="{DynamicResource MutedTextBrush}"/>
				</StackPanel>
			</Button>
		</Grid>

		<Grid Grid.Row="1" Margin="12,0,12,8">
			<StackPanel Name="EmptyScreenshotsText" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="False">
				<material:MaterialIcon Kind="ImageOutline" Width="40" Height="40" Foreground="{DynamicResource MutedTextBrush}"/>
				<TextBlock Text="Тут з'являться ваші скріншоти" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
			</StackPanel>
			<StackPanel Name="EmptyVideosText" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="False">
				<material:MaterialIcon Kind="VideoOutline" Width="40" Height="40" Foreground="{DynamicResource MutedTextBrush}"/>
				<TextBlock Text="Тут з'являться ваші відеозаписи" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
			</StackPanel>

			<ListBox Name="ScreenshotsListBox" Classes="gallery" Background="Transparent" DoubleTapped="ListBox_DoubleTapped">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="local:HistoryItem">
						<Border Classes="hcard" Width="236" Margin="6" CornerRadius="12" ClipToBounds="True"
						        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
							<Grid RowDefinitions="Auto,Auto">
								<Grid>
									<Border Height="132" Background="{DynamicResource CanvasBackdropBrush}">
										<Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
									</Border>
									<!-- Дії з'являються при наведенні на картку -->
									<Border Classes="hactions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="2" CornerRadius="9"
									        Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
										<StackPanel Orientation="Horizontal" Spacing="0">
											<Button Classes="Basic hbtn" ToolTip.Tip="Копіювати скріншот" Click="BtnCopyFromHistory_Click" Tag="{Binding Path}">
												<material:MaterialIcon Kind="ContentCopy"/>
											</Button>
											<Button Classes="Basic hbtn" ToolTip.Tip="Вивантажити на Google Диск" Click="BtnUploadFromHistory_Click" Tag="{Binding Path}">
												<material:MaterialIcon Kind="GoogleDrive" Foreground="#4285F4"/>
											</Button>
											<Button Classes="Basic hbtn danger" ToolTip.Tip="Видалити" Click="BtnDeleteFromHistory_Click" Tag="{Binding Path}">
												<material:MaterialIcon Kind="DeleteOutline"/>
											</Button>
										</StackPanel>
									</Border>
								</Grid>
								<StackPanel Grid.Row="1" Margin="12,8,12,10" Spacing="1">
									<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<ListBox Name="VideosListBox" IsVisible="False" Classes="gallery" Background="Transparent" DoubleTapped="ListBox_DoubleTapped">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="local:HistoryItem">
						<Border Classes="hcard" Width="236" Margin="6" CornerRadius="12" ClipToBounds="True"
						        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
							<Grid RowDefinitions="Auto,Auto">
								<Grid>
									<Border Height="132" Background="{DynamicResource CanvasBackdropBrush}">
										<Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
									</Border>
									<!-- Дії з'являються при наведенні на картку -->
									<Border Classes="hactions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="2" CornerRadius="9"
									        Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
										<StackPanel Orientation="Horizontal" Spacing="0">
											<Button Classes="Basic hbtn" ToolTip.Tip="Показати в папці" Click="BtnOpenFolder_Click" Tag="{Binding Path}">
												<material:MaterialIcon Kind="FolderOpenOutline"/>
											</Button>
											<Button Classes="Basic hbtn" ToolTip.Tip="Вивантажити на Google Диск" Click="BtnUploadFromHistory_Click" Tag="{Binding Path}">
												<material:MaterialIcon Kind="GoogleDrive" Foreground="#4285F4"/>
											</Button>
											<Button Classes="Basic hbtn danger" ToolTip.Tip="Видалити" Click="BtnDeleteFromHistory_Click" Tag="{Binding Path}">
												<material:MaterialIcon Kind="DeleteOutline"/>
											</Button>
										</StackPanel>
									</Border>
								</Grid>
								<StackPanel Grid.Row="1" Margin="12,8,12,10" Spacing="1">
									<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>

		<Border Name="ToastNotification" Grid.RowSpan="2" Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" Padding="25,15" IsVisible="False" IsHitTestVisible="False" ZIndex="50">
			<TextBlock Name="ToastText" Text="Скопійовано в буфер!" Foreground="{DynamicResource SukiText}" FontSize="16" FontWeight="SemiBold"/>
		</Border>

		<Border Name="DialogOverlay" Grid.RowSpan="2" Background="#99000000" IsVisible="False" ZIndex="100">
			<Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="35" CornerRadius="20" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
				<StackPanel Spacing="20">
					<TextBlock Name="DialogTitle" Text="Підтвердження" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
					<TextBlock Name="DialogMessage" Text="Видалити цей елемент?" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="350"/>
					<StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center" Margin="0,15,0,0">
						<Button Name="BtnDialogYes" Classes="Flat" Content="Так" Width="110" Click="BtnDialogYes_Click"/>
						<Button Name="BtnDialogNo" Classes="Basic" Content="Ні" Width="110" Click="BtnDialogNo_Click"/>
						<Button Name="BtnDialogOk" Classes="Flat" Content="ОК" Width="110" Click="BtnDialogOk_Click" IsVisible="False"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

	</Grid>
</suki:SukiWindow>
