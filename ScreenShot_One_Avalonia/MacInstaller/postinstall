#!/bin/bash
# Після встановлення:
#  1) знімаємо «карантин» — програма запускається без попереджень Gatekeeper і без Термінала;
#  2) віддаємо .app користувачу — тоді програма сама ставить наступні оновлення, без пароля адміністратора;
#  3) одразу запускаємо програму від імені користувача.
APP="/Applications/Screenshot_One.app"
/usr/bin/xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true

CONSOLE_USER=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
    /usr/sbin/chown -R "$CONSOLE_USER":staff "$APP" 2>/dev/null || true
    USER_ID=$(/usr/bin/id -u "$CONSOLE_USER")
    /bin/launchctl asuser "$USER_ID" /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/open "$APP" 2>/dev/null || true
fi
exit 0
