<suki:SukiWindow xmlns="https://github.com/avaloniaui"



        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"



        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"



        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"



        x:Class="ScreenShot_One_Avalonia.EditorWindow"



        Title="Редактор" Height="700" Width="1000"



        WindowState="Maximized"



        Icon="/Assets/icon.ico">







	<Grid RowDefinitions="Auto,*,Auto">



		<suki:GlassCard Grid.Row="0" Margin="10" Padding="5" CornerRadius="12">



			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">



				<StackPanel Orientation="Horizontal" Spacing="2">



				<Button Name="BtnBackToHistory" Classes="Basic" ToolTip.Tip="Назад до історії" Click="BtnBackToHistory_Click" IsVisible="False" Margin="2,0,4,0">



					<StackPanel Orientation="Horizontal" Spacing="4">



						<material:MaterialIcon Kind="ArrowLeft" Width="26" Height="26" Foreground="DeepSkyBlue"/>



						<TextBlock Text="До історії" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="DeepSkyBlue"/>



					</StackPanel>



				</Button>



				<Separator Name="SepBackToHistory" Classes="Vertical" Height="30" IsVisible="False"/>







				<Button Name="BtnSelect" Classes="Basic" ToolTip.Tip="Виділення" Click="BtnSelect_Click">



					<material:MaterialIcon Kind="CursorDefault" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>







				<Button Name="BtnSplit" Classes="Basic" ToolTip.Tip="Додати зображення поруч (Колаж)" Click="BtnSplit_Click" Foreground="DodgerBlue">



					<material:MaterialIcon Kind="ViewSplitVertical" Width="28" Height="28"/>



				</Button>







				<Button Name="BtnPasteImage" Classes="Basic" ToolTip.Tip="Вставити картинку поверх (Ctrl+V)" Click="BtnPasteImage_Click" Foreground="MediumPurple">

					<material:MaterialIcon Kind="ImageAdd" Width="28" Height="28"/>

				</Button>







				<Button Name="BtnCrop" Classes="Basic" ToolTip.Tip="Обрізати зображення" Click="BtnCrop_Click" Foreground="Orange">



					<material:MaterialIcon Kind="Crop" Width="28" Height="28"/>



				</Button>







				<Separator Classes="Vertical" Height="30"/>







				<Button Name="BtnStamp" Classes="Basic" ToolTip.Tip="Нумерація" Click="BtnStamp_Click">



					<material:MaterialIcon Kind="Numeric1Circle" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>



				<Button Name="BtnRectangle" Classes="Basic" ToolTip.Tip="Прямокутник" Click="BtnRectangle_Click">



					<material:MaterialIcon Kind="RectangleOutline" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>



				<Button Name="BtnArrow" Classes="Basic" ToolTip.Tip="Стрілочка" Click="BtnArrow_Click">



					<material:MaterialIcon Kind="ArrowTopRight" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>







				<Button Name="BtnConnector" Classes="Basic" ToolTip.Tip="Зв'язок (лінія з точками)" Click="BtnConnector_Click">



					<material:MaterialIcon Kind="VectorPolyline" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>







				<Button Name="BtnPencil" Classes="Basic" ToolTip.Tip="Олівець" Click="BtnPencil_Click">



					<material:MaterialIcon Kind="Pencil" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>



				<Button Name="BtnHighlighter" Classes="Basic" ToolTip.Tip="Маркер" Click="BtnHighlighter_Click">



					<material:MaterialIcon Kind="Marker" Foreground="#D97706" Width="28" Height="28"/>



				</Button>



				<Button Name="BtnText" Classes="Basic" ToolTip.Tip="Текст" Click="BtnText_Click">



					<material:MaterialIcon Kind="FormatText" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>







				<ComboBox Name="ComboFontSize" Width="100" Margin="5,0" SelectedIndex="1" ToolTip.Tip="Розмір тексту">



					<ComboBoxItem Content="14"/>



					<ComboBoxItem Content="18"/>



					<ComboBoxItem Content="24"/>



					<ComboBoxItem Content="36"/>



					<ComboBoxItem Content="48"/>



					<ComboBoxItem Content="72"/>



				</ComboBox>







				<Separator Classes="Vertical" Height="30"/>







				<Button Name="BtnBlur" Classes="Basic" ToolTip.Tip="Розмиття" Click="BtnBlur_Click">



					<material:MaterialIcon Kind="Blur" Foreground="DeepSkyBlue" Width="28" Height="28"/>



				</Button>







				<Button Name="BtnUndo" Classes="Basic" ToolTip.Tip="Скасувати (Ctrl+Z)" Click="BtnUndo_Click">



					<material:MaterialIcon Kind="Undo" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>







				<Button Name="BtnRedo" Classes="Basic" ToolTip.Tip="Повторити (Ctrl+Y)" Click="BtnRedo_Click">



					<material:MaterialIcon Kind="Redo" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>







				<Separator Classes="Vertical" Height="30"/>







				<Button Name="BtnCurrentColorIndicator" Width="40" Height="40" Margin="5" Click="BtnCurrentColorIndicator_Click" Cursor="Hand" ToolTip.Tip="Колір">



					<Button.Template>



						<ControlTemplate>



							<Ellipse Fill="{TemplateBinding Background}" Stroke="{DynamicResource SukiBorderBrush}" StrokeThickness="2"/>



						</ControlTemplate>



					</Button.Template>



				</Button>







				<Popup Name="ColorPalettePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=BtnCurrentColorIndicator}" IsLightDismissEnabled="True">



					<suki:GlassCard Padding="8">



						<UniformGrid Columns="4">



							<Button Background="Red" Width="32" Height="32" Margin="4" Click="BtnColorVariant_Click" CornerRadius="16" BorderThickness="0"/>



							<Button Background="LimeGreen" Width="32" Height="32" Margin="4" Click="BtnColorVariant_Click" CornerRadius="16" BorderThickness="0"/>



							<Button Background="DeepSkyBlue" Width="32" Height="32" Margin="4" Click="BtnColorVariant_Click" CornerRadius="16" BorderThickness="0"/>



							<Button Background="Orange" Width="32" Height="32" Margin="4" Click="BtnColorVariant_Click" CornerRadius="16" BorderThickness="0"/>



							<Button Background="White" Width="32" Height="32" Margin="4" Click="BtnColorVariant_Click" CornerRadius="16" BorderThickness="0"/>



							<Button Background="Black" Width="32" Height="32" Margin="4" Click="BtnColorVariant_Click" CornerRadius="16" BorderThickness="0"/>



							<Button Background="Yellow" Width="32" Height="32" Margin="4" Click="BtnColorVariant_Click" CornerRadius="16" BorderThickness="0"/>



							<Button Background="Purple" Width="32" Height="32" Margin="4" Click="BtnColorVariant_Click" CornerRadius="16" BorderThickness="0"/>



						</UniformGrid>



					</suki:GlassCard>



				</Popup>







				<Separator Classes="Vertical" Height="30"/>







				<Button Name="BtnPublicUpload" Classes="Basic" ToolTip.Tip="Хмарне посилання" Click="BtnPublicUpload_Click">



					<material:MaterialIcon Kind="CloudUpload" Width="28" Height="28" Foreground="{DynamicResource ToolbarIconBrush}"/>



				</Button>



				<Button Name="BtnDriveUpload" Classes="Basic" ToolTip.Tip="Завантажити на особистий Google Drive" Click="BtnDriveUpload_Click">



					<material:MaterialIcon Kind="GoogleDrive" Foreground="#4688F4" Width="28" Height="28"/>



				</Button>







				<Button Name="BtnSave" Classes="Primary" Click="BtnSave_Click" Margin="10,0">



					<StackPanel Orientation="Horizontal" Spacing="8">



						<material:MaterialIcon Kind="ContentSave" Width="24" Height="24"/>



						<TextBlock Text="Копіювати та закрити" VerticalAlignment="Center"/>



					</StackPanel>



				</Button>



				</StackPanel>



			</ScrollViewer>



		</suki:GlassCard>







		<ScrollViewer Grid.Row="1" Name="MainScrollViewer" Background="{DynamicResource CanvasBackdropBrush}" PointerWheelChanged="MainScrollViewer_PointerWheelChanged" PointerPressed="MainScrollViewer_PointerPressed" PointerMoved="MainScrollViewer_PointerMoved" PointerReleased="MainScrollViewer_PointerReleased">



			<LayoutTransformControl Name="CanvasScaleControl" HorizontalAlignment="Center" VerticalAlignment="Center">



				<LayoutTransformControl.LayoutTransform>



					<ScaleTransform ScaleX="1" ScaleY="1" />



				</LayoutTransformControl.LayoutTransform>







				<Grid>



					<Canvas Name="DrawingCanvas" Background="Transparent" PointerPressed="DrawingCanvas_PointerPressed" PointerMoved="DrawingCanvas_PointerMoved" PointerReleased="DrawingCanvas_PointerReleased">



						<Image Name="ScreenshotImage" />







						<Image Name="SecondScreenshotImage" IsVisible="False" />



						<Border Name="SplitPlaceholder" IsVisible="False" Background="{DynamicResource SukiLightBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="2" CornerRadius="10" Cursor="Hand" PointerPressed="SplitPlaceholder_PointerPressed">



							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False">



								<material:MaterialIcon Kind="ImageAdd" Width="64" Height="64" Foreground="{DynamicResource SukiTextLow}"/>



								<TextBlock Text="Клікніть, щоб вибрати файл,&#x0a;перетягніть сюди файл (Drag &amp; Drop)&#x0a;або натисніть Ctrl+V" Foreground="{DynamicResource SukiTextLow}" FontSize="18" TextAlignment="Center" FontWeight="SemiBold"/>



							</StackPanel>



						</Border>



					</Canvas>







					<Grid Name="CropOverlayGrid" IsVisible="False">



						<Path Name="CropDarkOverlay" Fill="#CC000000" IsHitTestVisible="False"/>



						<Canvas IsHitTestVisible="False">



							<Rectangle Name="CropSelectionRect" Stroke="White" StrokeThickness="2" StrokeDashArray="4,2" StrokeJoin="Round" IsVisible="False"/>



						</Canvas>







						<Canvas>



							<Border Name="CropControlsPanel" Background="#FA151515" CornerRadius="8" Padding="5" IsVisible="False" BoxShadow="0 2 10 0 #80000000">



								<StackPanel Orientation="Horizontal">



									<Button Name="BtnConfirmCrop" Classes="Basic" Width="40" Height="40" CornerRadius="20" Click="BtnConfirmCrop_Click" ToolTip.Tip="Застосувати обрізку" Foreground="LimeGreen">



										<material:MaterialIcon Kind="Check" Width="24" Height="24"/>



									</Button>



									<Button Name="BtnCancelCrop" Classes="Basic" Width="40" Height="40" CornerRadius="20" Click="BtnCancelCrop_Click" ToolTip.Tip="Скасувати" Foreground="Red" Margin="5,0,0,0">



										<material:MaterialIcon Kind="Close" Width="24" Height="24"/>



									</Button>



								</StackPanel>



							</Border>



						</Canvas>



					</Grid>



				</Grid>



			</LayoutTransformControl>



		</ScrollViewer>







		<Border Name="ToastNotification" Grid.Row="1" Background="#CC000000" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" Padding="25,15" IsVisible="False" IsHitTestVisible="False">



			<TextBlock Name="ToastText" Text="Скопійовано в буфер!" Foreground="White" FontSize="18" FontWeight="SemiBold"/>



		</Border>



	</Grid>



</suki:SukiWindow>